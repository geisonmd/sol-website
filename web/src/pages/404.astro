---
import BaseLayout from '../layouts/BaseLayout.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import ArrowDiagonal from '../assets/icons/arrow-diagonal.svg'
import IconCircleHelp from 'lucide-static/icons/circle-help.svg?raw'
---

<BaseLayout title="Página no encontrada" description="404 — Página no encontrada">
  <SiteHeader />

  <section class="relative flex items-center justify-center overflow-hidden bg-white py-32">
    <div
      class="pointer-events-none absolute -left-40 -top-40 size-[550px] rounded-full bg-[#ed8419]/10 blur-[120px]"
    >
    </div>
    <div class="relative flex w-full max-w-[700px] flex-col items-center gap-6 text-center">
      <span
        class="flex size-16 items-center justify-center rounded-full bg-[#ed8419] [&>svg]:size-8 [&>svg]:text-white"
        set:html={IconCircleHelp}
      />
      <p class="font-sans text-[120px] leading-none tracking-[-2px] text-black">404</p>
      <h1 class="font-sans text-4xl leading-[1.3] tracking-[-0.8px] text-black">
        Esta página no existe o fue movida
      </h1>
      <p class="font-sans text-base text-[#808080]">
        Volvé a la página de inicio o contactanos si necesitás ayuda.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/"
          class="font-franklin-medium flex items-center gap-2 rounded-[35px] bg-[#25d366] px-8 py-4 text-base tracking-[-0.32px] text-white"
        >
          Ir a la página de inicio
          <img src={ArrowDiagonal.src} alt="" class="size-6 invert" />
        </a>
        <a
          href="/contacto/"
          class="font-franklin-medium flex items-center gap-2 rounded-[35px] border border-[#2e2e2e] px-8 py-4 text-base tracking-[-0.32px] text-[#2e2e2e]"
        >
          Hablar con nosotros
        </a>
      </div>
    </div>
  </section>

  <SiteFooter />
</BaseLayout>
