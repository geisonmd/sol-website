---
import BaseLayout from '../../layouts/BaseLayout.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import PageHero from '../../components/PageHero.astro'
import BeneficiosLaborales from '../../components/trabaje/BeneficiosLaborales.astro'
import ProcesoContratacion from '../../components/trabaje/ProcesoContratacion.astro'
import Sucursales from '../../components/Sucursales.astro'
import VacanteCard from '../../components/trabaje/VacanteCard.astro'
import ArrowDiagonal from '../../assets/icons/arrow-diagonal.svg'
import { fetchCollection } from '../../lib/payload'

interface Vacante {
  id: number
  title: string
  slug: string
  featuredImage?: { url?: string | null } | null
  city?: { name: string } | null
  workMode?: 'presencial' | 'remoto' | 'hibrido' | null
  employmentType?: 'efectivo' | 'temporal' | 'pasantia' | 'freelance' | null
  isOpen?: boolean | null
}

const vacantes = await fetchCollection<Vacante>('vacantes', {
  'where[isOpen][equals]': 'true',
  sort: '-publishedAt',
})

const whatsappHref = `https://wa.me/595983550110?text=${encodeURIComponent('Hola, quiero enviar mi CV para trabajar en Sol Internet')}`
---

<BaseLayout
  title="Trabaje con nosotros"
  description="Sé parte de un equipo compuesto por personas fantásticas"
>
  <SiteHeader />
  <PageHero title="Sé parte de un equipo compuesto por personas fantásticas" />
  <BeneficiosLaborales />

  <section class="flex items-center justify-center bg-white">
    <div class="flex w-full max-w-[1216px] flex-col gap-8 py-24">
      <div class="flex flex-wrap items-center justify-between gap-6">
        <p class="font-sans text-5xl leading-[1.3] tracking-[-1px] text-black">
          Vacancias disponibles
        </p>
      </div>
      {
        vacantes.length > 0 ? (
          <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {vacantes.map((vacante) => (
              <VacanteCard vacante={vacante} />
            ))}
          </div>
        ) : (
          <p class="font-sans text-base text-[#808080]">
            No tenemos vacancias abiertas en este momento, pero podés enviarnos tu CV para
            futuras oportunidades.
          </p>
        )
      }
      <div
        id="formulario-trabajo"
        class="relative flex flex-col items-start gap-6 overflow-hidden rounded-[32px] bg-[#fafafa] p-10 sm:flex-row sm:items-center sm:justify-between"
      >
        <div class="flex flex-col gap-2">
          <p class="font-franklin-book text-3xl tracking-[-0.6px] text-black">
            No estás encontrando tu cargo ideal?
          </p>
          <p class="font-sans text-base tracking-[-0.32px] text-[#808080]">
            Envianos tu CV por WhatsApp o a talentos@sol.com.py y entraremos en contacto
            contigo apenas surja una vacante que se ajuste a tu perfil.
          </p>
        </div>
        <a
          href={whatsappHref}
          class="font-franklin-medium flex shrink-0 items-center gap-2.5 rounded-[35px] bg-[#25d366] px-8 py-4 text-base tracking-[-0.32px] text-[#181818]"
        >
          Enviar mi CV
          <img src={ArrowDiagonal.src} alt="" class="size-6" />
        </a>
      </div>
    </div>
  </section>

  <Sucursales />
  <ProcesoContratacion />
  <SiteFooter />
</BaseLayout>
