---
import BaseLayout from '../../layouts/BaseLayout.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import Faq from '../../components/home/Faq.astro'
import Cta from '../../components/home/Cta.astro'
import BeneficiosSolPlay from '../../components/sol-play/BeneficiosSolPlay.astro'
import GrillaCanales from '../../components/sol-play/GrillaCanales.astro'
import ArrowDiagonal from '../../assets/icons/arrow-diagonal.svg'
import SolPlayMark from '../../assets/brand/sol-play-mark.svg'
import bg from '../../assets/home/sol-play-bg.png'
import googlePlayBadge from '../../assets/badges/google-play.jpg'
import androidTvBadge from '../../assets/badges/android-tv.jpg'

const solPlayFaqs = [
  {
    q: '¿Puedo tener más de un televisor conectado a través de Sol Play?',
    a: 'Sí, se puede. En caso de que el cliente tenga instalación por fibra óptica se pueden instalar hasta 4 receptores como máximo. Si el cliente está conectado por antena, solo se puede conectar 1 receptor.',
  },
  {
    q: '¿Si quiero instalar más de 1 receptor pagaré el doble o cómo es?',
    a: 'El costo mensual para usar 1 receptor en un televisor es de 10,00 USD, y si el cliente quiere 2 pagará 15,00 USD, y si quiere 3 pagará 20,00 USD. Y así sucesivamente: solo se agregan 5,00 USD sobre cada receptor habilitado.',
  },
  {
    q: '¿Para instalar Sol Play se firma un contrato? ¿Hay multa si quiero cancelar?',
    a: 'No es necesaria la firma de un contrato para instalar Sol Play, y al cancelar tampoco se genera multa. El receptor queda instalado en comodato, por lo que al cancelar se retira el mismo; si no se puede retirar o está dañado, se facturará su valor en la cuenta del cliente.',
  },
  {
    q: '¿Las inclemencias del tiempo ocasionan interferencias en Sol Play?',
    a: 'No, el clima no interfiere en nada el funcionamiento de Sol Play porque no tiene conexión vía satelital: es una app que se descarga e instala, dependiendo únicamente del funcionamiento del internet.',
  },
]
---

<BaseLayout
  title="Sol Play"
  description="Sol Play, la TV que te conecta con tus emociones"
>
  <SiteHeader />

  <section
    class="flex items-center justify-center bg-[#2e2e2e] bg-cover bg-top px-4"
    style={`background-image: linear-gradient(90deg, rgba(46,46,46,0.9), rgba(46,46,46,0.5)), url(${bg.src})`}
  >
    <div class="flex w-full max-w-[1216px] flex-col items-start gap-8 py-24">
      <span class="flex size-16 items-center justify-center rounded-full bg-[#ed8419]">
        <img src={SolPlayMark.src} alt="Sol Play" class="h-[33px] w-16" />
      </span>
      <p class="max-w-[700px] font-sans text-[56px] leading-[1.2] tracking-[-1.1px] text-white">
        Sol Play, la TV que te conecta con tus emociones
      </p>
      <p class="max-w-[560px] font-sans text-lg tracking-[-0.36px] text-white/80">
        Olvídate de los cortes molestos y explora la televisión a través de internet con
        nuestra APP exclusiva.
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <a
          href="/planes-por-fibra-optica/"
          class="font-franklin-medium flex items-center gap-2 rounded-[35px] bg-[#25d366] px-8 py-4 text-base tracking-[-0.32px] text-white"
        >
          Quiero contratar
          <img src={ArrowDiagonal.src} alt="" class="size-6 invert" />
        </a>
        <a
          href={`https://wa.me/595983550110?text=${encodeURIComponent('Hola, quiero conocer más sobre Sol Play')}`}
          class="font-franklin-medium flex items-center justify-center rounded-[35px] border-[1.5px] border-white px-8 py-4 text-base tracking-[-0.32px] text-white"
        >
          Conocer más
        </a>
      </div>
      <div class="flex items-center gap-4 pt-4">
        <img src={googlePlayBadge.src} alt="Descarga en Google Play" class="h-12 rounded-md" />
        <img src={androidTvBadge.src} alt="Disponible en Android TV" class="h-12 rounded-md" />
      </div>
    </div>
  </section>

  <section class="flex items-center justify-center bg-white">
    <div class="flex w-full max-w-[1216px] flex-col items-center gap-12 py-24 lg:flex-row">
      <div class="flex flex-col gap-6 lg:w-1/2">
        <p class="font-sans text-4xl leading-[1.3] tracking-[-0.8px] text-black">
          Una plataforma de canales con tus programas favoritos
        </p>
        <p class="font-sans text-base tracking-[-0.32px] text-[#808080]">
          Sol Play es nuestra plataforma digital para disfrutar de televisión en familia.
          Funciona con el sistema Android y podés descargarla en tu Smart TV.
        </p>
        <ul class="flex flex-col gap-3 font-sans text-base tracking-[-0.32px] text-black">
          <li>+100 canales nacionales e internacionales con calidad HD.</li>
          <li>
            Servicio dedicado, proporcionando una experiencia de televisión sin cortes.
          </li>
          <li>Sin necesidad de instalar antenas no deseadas.</li>
        </ul>
        <p class="font-sans text-sm text-[#808080]">
          *Si no cuentas con una Smart TV nosotros instalamos gratuitamente un receptor Sol
          Play.
        </p>
      </div>
      <div class="flex flex-col gap-4 rounded-3xl bg-[#fafafa] p-8 lg:w-1/2">
        <p class="font-franklin-book text-xl italic tracking-[-0.4px] text-black">
          "El servicio funciona muy bien, nunca pensé en cambiar, porque Sol es completa en
          cuanto al funcionamiento del servicio y siempre que necesitas están para
          auxiliarnos."
        </p>
        <p class="font-franklin-medium text-base tracking-[-0.32px] text-black uppercase">
          Antonio Sebastiao Pinto
        </p>
      </div>
    </div>
  </section>

  <BeneficiosSolPlay />
  <GrillaCanales />
  <Faq title="¿Tenés alguna duda? Te lo respondemos" items={solPlayFaqs} />
  <Cta />
  <SiteFooter />
</BaseLayout>
