---
import BaseLayout from '../../layouts/BaseLayout.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import UltimasActividades from '../../components/UltimasActividades.astro'
import ArrowDiagonal from '../../assets/icons/arrow-diagonal.svg'
import IconCheck from 'lucide-static/icons/check.svg?raw'

const planes = [
  { label: 'Planes por Fibra Óptica', href: '/planes-por-fibra-optica/' },
  { label: 'Planes por Antena Xtreme', href: '/planes-por-antena-xtreme/' },
]
---

<BaseLayout title="Gracias" description="Gracias por tu interés en Sol Internet">
  <SiteHeader />

  <section class="relative flex items-center justify-center overflow-hidden bg-white py-24">
    <div
      class="pointer-events-none absolute -left-40 -top-40 size-[550px] rounded-full bg-[#25d366]/10 blur-[120px]"
    >
    </div>
    <div class="relative flex w-full max-w-[700px] flex-col items-center gap-6 text-center">
      <span
        class="flex size-16 items-center justify-center rounded-full bg-[#25d366] [&>svg]:size-8 [&>svg]:text-white"
        set:html={IconCheck}
      />
      <h1 class="font-sans text-5xl leading-[1.3] tracking-[-1px] text-black">
        Gracias por tu interés
      </h1>
      <p class="font-sans text-base text-[#808080]">
        Revisaremos tu solicitud lo más breve posible y entraremos en contacto contigo.
      </p>
      <a
        href="/"
        class="font-franklin-medium flex items-center gap-2 rounded-[35px] border border-[#2e2e2e] px-8 py-4 text-base tracking-[-0.32px] text-[#2e2e2e]"
      >
        Ir a la página de inicio
        <img src={ArrowDiagonal.src} alt="" class="size-6" />
      </a>
    </div>
  </section>

  <section class="flex items-center justify-center bg-[#fafafa]">
    <div class="flex w-full max-w-[1216px] flex-col gap-10 py-16">
      <p class="font-sans text-4xl leading-[1.3] tracking-[-0.8px] text-black">
        Conozca nuestros planes
      </p>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {
          planes.map((p) => (
            <a
              href={p.href}
              class="flex items-center justify-between gap-4 rounded-3xl border border-[#e6e6e6] bg-white p-8"
            >
              <p class="font-franklin-medium text-lg tracking-[-0.36px] text-black uppercase">
                {p.label}
              </p>
              <span class="font-franklin-medium flex shrink-0 items-center gap-2 text-base text-[#ed8419]">
                Visitar página
                <img src={ArrowDiagonal.src} alt="" class="size-5" />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <UltimasActividades />
  <SiteFooter />
</BaseLayout>
