      { label: 'Deportes 10', href: 'https://d10.paraguay.com/' },
    ],
  },
  {
    icon: IconLandmark,
    title: 'Bancos',
    links: [
      { label: 'Banco Visión', href: 'https://www.visionbanco.com/' },
      { label: 'Banco GNB', href: 'https://www.bancognb.com.py/' },
      { label: 'Itaú', href: 'https://www.itau.com.py/' },
      { label: 'Sudameris', href: 'https://www.sudameris.com.py/' },
      { label: 'Banco Rio', href: 'https://www.rio.com.py/' },
      { label: 'Continental', href: 'https://bancontinental.com.py/' },
      { label: 'Familiar', href: 'https://www.familiar.com.py/' },
    ],
  },
  {
    icon: IconRadio,
    title: 'Radios',
    links: [
      { label: 'Santa Rita', href: 'https://www.radiosantarita.com.py/' },
      { label: 'Progreso', href: 'https://www.radioprogreso.com.py/' },
      { label: 'Suceso', href: 'https://radiosuceso.com/' },
      { label: 'Estación 40', href: 'https://estacion40.com.py/' },
      { label: 'Radio Luz', href: 'https://www.radioluzfmpy.com/' },
