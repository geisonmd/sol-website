---

<BaseLayout title="Utilidades" description="Enlaces útiles para nuestros clientes">
  <SiteHeader />
  <PageHero
    title="Utilidades"
    note="Enlaces rápidos a los sitios que más usás: noticias, clima, bancos, radios y más."
  />

  <section class="flex items-center justify-center bg-white">
    <div class="flex w-full max-w-[1216px] flex-col gap-8 py-8">
      <div
        class="flex flex-col items-start justify-between gap-6 rounded-3xl bg-[#fafafa] p-8 sm:flex-row sm:items-center"
      >
        <div class="flex flex-col gap-1">
          <p class="font-franklin-medium text-sm tracking-[0.1em] text-[#ed8419] uppercase">
            Cambio del día
          </p>
          <p class="font-sans text-2xl tracking-[-0.44px] text-black">
            Consultá la cotización actualizada
          </p>
          <p class="font-sans text-sm text-[#808080]">Fuente: Santa Rita Cambios</p>
        </div>
        <a
          href="https://santaritacambios.com.py"
          target="_blank"
          rel="noopener noreferrer"
          class="font-franklin-medium flex shrink-0 items-center gap-2.5 rounded-[35px] border border-[#2e2e2e] px-8 py-4 text-base tracking-[-0.32px] text-[#2e2e2e]"
        >
          Ver cotización
          <img src={ArrowDiagonal.src} alt="" class="size-6" />
        </a>
      </div>
    </div>
  </section>

  <section class="flex items-center justify-center bg-white">
    <div class="grid w-full max-w-[1216px] grid-cols-1 gap-6 py-16 sm:grid-cols-2 lg:grid-cols-3">
      {grupos.map((g) => <EnlacesGrupo icon={g.icon} title={g.title} links={g.links} />)}
    </div>
  </section>

  <Cta />
  <SiteFooter />
</BaseLayout>
