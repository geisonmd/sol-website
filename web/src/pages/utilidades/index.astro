      { label: 'Facebook', href: 'https://facebook.com' },
    ],
  },
  {
    icon: IconNewspaper,
    title: 'Noticias',
    links: [
      { label: 'ABC Color', href: 'https://www.abc.com.py/' },
      { label: 'Vanguardia', href: 'https://diariovanguardia.com.py/' },
      { label: 'Última Hora', href: 'https://www.ultimahora.com/' },
      { label: 'Popular', href: 'https://www.popular.com.py/' },
      { label: 'La Nación', href: 'https://www.lanacion.com.py/' },
      { label: 'Paraguay.com', href: 'https://www.paraguay.com/' },
      { label: 'Reuters', href: 'https://br.reuters.com/' },
    ],
  },
  {
    icon: IconWheat,
    title: 'Agricultura',
    links: [
      {
        label: 'Chicago',
        href: 'https://www.cmegroup.com/trading/agricultural/grain-and-oilseed/soybean.html',
      },
      { label: 'Bolsa ADM', href: 'https://www.e-adm.com/pda/futures.aspx' },
      { label: 'Canal Rural', href: 'https://www.canalrural.com.br/ultimas-noticias/' },
