---
import BaseLayout from '../../layouts/BaseLayout.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import UltimasActividades from '../../components/UltimasActividades.astro'
import Cta from '../../components/home/Cta.astro'
import ArrowDiagonal from '../../assets/icons/arrow-diagonal.svg'
import { fetchCollection, mediaUrl } from '../../lib/payload'
import { renderLexical } from '../../lib/lexical'

interface Post {
  id: number
  title: string
  slug: string
  publishedAt?: string | null
  featuredImage?: { url?: string | null } | null
  content?: unknown
  meta?: { description?: string | null }
}

export async function getStaticPaths() {
  const posts = await fetchCollection<Post>('posts')
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }))
}

interface Props {
  post: Post
}
const { post } = Astro.props

const date = post.publishedAt
  ? new Intl.DateTimeFormat('es-PY', { day: '2-digit', month: 'long', year: 'numeric' }).format(
      new Date(post.publishedAt),
    )
  : null

const bodyHtml = renderLexical(post.content)
const whatsappHref = `https://wa.me/595983550110?text=${encodeURIComponent('Hola, quiero contratar un plan de Sol Internet')}`
---

<BaseLayout title={post.title} description={post.meta?.description ?? post.title}>
  <SiteHeader />

  <section class="flex items-center justify-center bg-white">
    <div class="flex w-full max-w-[760px] flex-col gap-4 px-4 py-16">
      <p class="font-sans text-sm text-[#808080]">
        Geison Dreon{date && ` · ${date}`}
      </p>
      <h1 class="font-sans text-4xl leading-[1.3] tracking-[-0.8px] text-black uppercase">
        {post.title}
      </h1>
      {
        post.featuredImage?.url && (
          <img
            src={mediaUrl(post.featuredImage)}
            alt={post.title}
            class="mt-4 w-full rounded-3xl object-cover"
          />
        )
      }
      <div
        class="post-content mt-6 flex flex-col gap-4 font-sans text-base tracking-[-0.32px] text-black"
        set:html={bodyHtml}
      />
      <a
        href={whatsappHref}
        class="font-franklin-medium mt-4 flex w-fit items-center gap-2 rounded-[35px] bg-[#25d366] px-8 py-4 text-base tracking-[-0.32px] text-white"
      >
        Quiero contratar
        <img src={ArrowDiagonal.src} alt="" class="size-6 invert" />
      </a>
    </div>
  </section>

  <UltimasActividades />
  <Cta />
  <SiteFooter />
</BaseLayout>

<style>
  .post-content :global(img) {
    border-radius: 24px;
    max-width: 100%;
  }
  .post-content :global(h2) {
    font-size: 1.75rem;
    letter-spacing: -0.4px;
    margin-top: 0.5rem;
  }
  .post-content :global(a) {
    color: #ed8419;
    text-decoration: underline;
  }
</style>
