---
import BaseLayout from '../../layouts/BaseLayout.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import PageHero from '../../components/PageHero.astro'
import BlogCard from '../../components/blog/BlogCard.astro'
import { fetchCollection } from '../../lib/payload'

interface Post {
  id: number
  title: string
  slug: string
  publishedAt?: string | null
  featuredImage?: { url?: string | null } | null
}

const posts = await fetchCollection<Post>('posts', { sort: '-publishedAt' })
const featured = posts.slice(0, 3)
---

<BaseLayout
  title="Blog"
  description="Acompaña todas nuestras publicaciones de Sol Internet"
>
  <SiteHeader />
  <PageHero
    title="Acompaña todas nuestras publicaciones"
    note="Todo sobre noticias, novedades, ideas que pueden mejorar tu experiencia con tu internet."
  />

  <section class="flex items-center justify-center bg-white">
    <div class="flex w-full max-w-[1216px] flex-col gap-10 py-16">
      <p class="font-sans text-4xl leading-[1.3] tracking-[-0.8px] text-black">
        Últimas publicaciones del blog
      </p>
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((post) => <BlogCard post={post} />)}
      </div>
    </div>
  </section>

  <section class="flex items-center justify-center bg-[#fafafa]">
    <div class="flex w-full max-w-[1216px] flex-col gap-10 py-16">
      <div class="flex flex-wrap items-center justify-between gap-6">
        <p class="font-sans text-4xl leading-[1.3] tracking-[-0.8px] text-black">
          Todas las publicaciones
        </p>
        <input
          id="blog-search"
          type="search"
          placeholder="Buscar publicaciones..."
          class="w-full max-w-[320px] rounded-[35px] border border-[#e6e6e6] bg-white px-6 py-3 font-sans text-base tracking-[-0.32px] text-black outline-none placeholder:text-[#808080]"
        />
      </div>
      <div id="blog-grid" class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          posts.map((post) => (
            <div class="blog-item" data-title={post.title.toLowerCase()}>
              <BlogCard post={post} />
            </div>
          ))
        }
      </div>
      <p id="blog-empty" class="hidden text-center font-sans text-base text-[#808080]">
        No se encontraron publicaciones.
      </p>
    </div>
  </section>

  <SiteFooter />
</BaseLayout>

<script>
  const input = document.getElementById('blog-search') as HTMLInputElement
  const items = Array.from(document.querySelectorAll<HTMLElement>('.blog-item'))
  const empty = document.getElementById('blog-empty')

  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase()
    let visible = 0
    for (const item of items) {
      const match = item.dataset.title?.includes(q)
      item.style.display = match ? '' : 'none'
      if (match) visible++
    }
    empty?.classList.toggle('hidden', visible > 0)
  })
</script>
