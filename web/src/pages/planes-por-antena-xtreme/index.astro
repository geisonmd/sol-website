---
import BaseLayout from '../../layouts/BaseLayout.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import PlanesHero from '../../components/planes/PlanesHero.astro'
import PlanesBeneficios from '../../components/planes/PlanesBeneficios.astro'
import PlanCard from '../../components/planes/PlanCard.astro'
import Testemunial from '../../components/home/Testemunial.astro'
import Faq from '../../components/home/Faq.astro'
import Cta from '../../components/home/Cta.astro'
import { fetchCollection } from '../../lib/payload'

interface Plan {
  id: number
  title: string
  slug: string
  tipo: 'fibra' | 'xtreme'
  download: number
  upload: number
  priceUSD: number
  priceGs?: number | null
}

const planes = await fetchCollection<Plan>('planes', {
  'where[tipo][equals]': 'xtreme',
  sort: 'priceUSD',
})
---

<BaseLayout
  title="Planes por antena Xtreme"
  description="Conozca nuestros planes de internet por antena Xtreme"
>
  <SiteHeader />
  <PlanesHero title="Conozca nuestros planes por antena Xtreme" />
  <PlanesBeneficios />
  <section class="flex items-center justify-center bg-white">
    <div class="flex w-full max-w-[1216px] flex-col gap-16 py-16">
      <p class="font-sans text-5xl leading-[1.3] tracking-[-1px] text-black">
        Planes de internet por antena
      </p>
      <div class="flex flex-wrap justify-center gap-8">
        {planes.map((plan) => <PlanCard plan={plan} />)}
      </div>
    </div>
  </section>
  <Testemunial title="Que dicen sobre nosotros" />
  <Faq />
  <Cta />
  <SiteFooter />
</BaseLayout>
