---
import IconHeadset from 'lucide-static/icons/headset.svg?raw'
import IconPhoneCall from 'lucide-static/icons/phone-call.svg?raw'
import IconCreditCard from 'lucide-static/icons/credit-card.svg?raw'
import IconUserCheck from 'lucide-static/icons/user-check.svg?raw'

const departamentos = [
  {
    icon: IconHeadset,
    title: 'Soporte técnico',
    text: '¿Estás con problemas con tu internet?',
    action: 'Llama al *10 000',
    href: 'tel:*10000',
  },
  {
    icon: IconPhoneCall,
    title: 'Departamento Comercial',
    text: '¿Tienes consultas sobre los planes de internet?',
    action: 'Llamá al *10 000 y presioná 2',
    href: 'tel:*10000',
  },
  {
    icon: IconCreditCard,
    title: 'Departamento de cobranza',
    text: '¿Deseas saber sobre facturas y pagos?',
    action: 'Llamá al *10 000 y presioná 3',
    href: 'tel:*10000',
  },
  {
    icon: IconUserCheck,
    title: 'Talentos',
    text: '¿Deseas trabajar con nosotros?',
    action: 'Completa el formulario',
    href: '/trabaje-con-nosotros/',
  },
]
---

<section class="flex items-center justify-center bg-white">
  <div class="flex w-full max-w-[1216px] flex-col gap-16 py-24">
    <p class="max-w-[600px] font-sans text-5xl leading-[1.3] tracking-[-1.28px] text-black">
      Contacta con un departamento específico
    </p>
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        departamentos.map((d) => (
          <a
            href={d.href}
            class="flex flex-col gap-4 rounded-3xl border border-[#e6e6e6] bg-white p-8"
          >
            <span class="flex size-12 items-center justify-center rounded-full bg-[#ed8419]/10 text-[#ed8419] [&>svg]:size-6">
              <Fragment set:html={d.icon} />
            </span>
            <p class="font-franklin-medium text-lg tracking-[-0.36px] text-black uppercase">
              {d.title}
            </p>
            <p class="font-sans text-base tracking-[-0.32px] text-[#808080]">{d.text}</p>
            <p class="font-franklin-medium text-base tracking-[-0.32px] text-[#ed8419]">
              {d.action}
            </p>
          </a>
        ))
      }
    </div>
  </div>
</section>
