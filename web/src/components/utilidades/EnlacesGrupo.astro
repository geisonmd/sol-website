---
import IconExternalLink from 'lucide-static/icons/external-link.svg?raw'

interface Link {
  label: string
  href: string
}

interface Props {
  icon: string
  title: string
  links: Link[]
}
const { icon, title, links } = Astro.props
---

<div class="flex flex-col gap-4 rounded-3xl border border-[#e6e6e6] bg-white p-6">
  <div class="flex items-center gap-3">
    <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-[#ed8419]/10 text-[#ed8419] [&>svg]:size-5">
      <Fragment set:html={icon} />
    </span>
    <p class="font-franklin-medium text-base tracking-[-0.32px] text-black uppercase">{title}</p>
  </div>
  <div class="flex flex-col gap-1">
    {
      links.map((l) => (
        <a
          href={l.href}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between gap-2 rounded-lg px-2 py-1.5 font-sans text-sm text-[#2e2e2e] hover:bg-[#fafafa]"
        >
          {l.label}
          <span class="size-4 shrink-0 text-[#808080] [&>svg]:size-4" set:html={IconExternalLink} />
        </a>
      ))
    }
  </div>
</div>
