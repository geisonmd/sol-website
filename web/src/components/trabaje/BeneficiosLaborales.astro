---
const items = [
  {
    title: 'Remuneración a tu Medida',
    text: 'Ofrecemos una remuneración competitiva y justa en línea con tus responsabilidades y desempeño.',
  },
  {
    title: 'Buen Ambiente Laboral',
    text: 'Cultivamos un espacio de trabajo positivo y colaborativo que inspira a todos.',
  },
  {
    title: 'Compromiso con tus Necesidades',
    text: 'Estamos dedicados a atender y apoyar tus necesidades para tu éxito y bienestar.',
  },
  {
    title: 'Seriedad y Ética en el Trato',
    text: 'Nuestra relación se basa en la seriedad, el respeto y la ética profesional.',
  },
  {
    title: 'Valoración de tu Contribución',
    text: 'Reconocimiento y valoración de tu esfuerzo y aporte al equipo.',
  },
]
---

<section class="flex items-center justify-center bg-[#fafafa]">
  <div class="flex w-full max-w-[1216px] flex-col gap-16 py-24">
    <p class="max-w-[488px] font-sans text-5xl leading-[1.3] tracking-[-1.28px] text-black">
      Nuestros beneficios laborales
    </p>
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-5">
      {
        items.map((item, i) => (
          <div class="flex flex-col gap-4">
            <p class="font-franklin-medium text-sm text-[#ed8419]">
              {String(i + 1).padStart(2, '0')}
            </p>
            <p class="font-franklin-medium text-base tracking-[-0.32px] text-black">
              {item.title}
            </p>
            <p class="font-sans text-base tracking-[-0.32px] text-[#808080]">{item.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
