---
import IconClock from 'lucide-static/icons/clock.svg?raw'
import IconMapPin from 'lucide-static/icons/map-pin.svg?raw'
import IconMessageCircle from 'lucide-static/icons/message-circle.svg?raw'
import { fetchCollection, mediaUrl } from '../lib/payload'

interface Sucursal {
  id: number
  name: string
  slug: string
  image?: { url?: string | null } | null
  city?: { name: string } | null
  businessHours: string
  googleMapsUrl?: string | null
  managerContactLink?: string | null
}

interface Props {
  title?: string
}
const { title = 'Conozca nuestras oficinas' } = Astro.props

const sucursales = await fetchCollection<Sucursal>('sucursales', { sort: 'name' })
---

<section id="sucursales" class="flex items-center justify-center bg-white">
  <div class="flex w-full max-w-[1216px] flex-col gap-16 py-24">
    <p class="font-sans text-5xl leading-[1.3] tracking-[-1px] text-black">{title}</p>
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        sucursales.map((s) => (
          <div class="flex flex-col overflow-hidden rounded-3xl border border-[#e6e6e6] bg-white">
            {s.image?.url && (
              <img src={mediaUrl(s.image)} alt={s.name} class="h-[180px] w-full object-cover" />
            )}
            <div class="flex flex-col gap-4 p-6">
              <p class="font-franklin-medium text-lg tracking-[-0.36px] text-black">
                {s.name}
                {s.city?.name && s.city.name !== s.name && (
                  <span class="text-[#808080]"> — {s.city.name}</span>
                )}
              </p>
              <div class="flex items-start gap-2 font-sans text-sm tracking-[-0.28px] text-[#808080]">
                <span class="size-5 shrink-0 text-[#ed8419]" set:html={IconClock} />
                <span set:html={s.businessHours} />
              </div>
              <div class="flex flex-col gap-2 pt-2">
                {s.managerContactLink && (
                  <a
                    href={s.managerContactLink}
                    class="flex items-center gap-2 font-franklin-medium text-sm tracking-[-0.28px] text-[#25d366]"
                  >
                    <span class="size-5 shrink-0" set:html={IconMessageCircle} />
                    Contactar al encargado
                  </a>
                )}
                {s.googleMapsUrl && (
                  <a
                    href={s.googleMapsUrl}
                    class="flex items-center gap-2 font-franklin-medium text-sm tracking-[-0.28px] text-[#ed8419]"
                  >
                    <span class="size-5 shrink-0" set:html={IconMapPin} />
                    Ver localización
                  </a>
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
