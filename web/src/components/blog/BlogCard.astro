---
import ArrowDiagonal from '../../assets/icons/arrow-diagonal.svg'
import { mediaUrl } from '../../lib/payload'

interface Post {
  id: number
  title: string
  slug: string
  publishedAt?: string | null
  featuredImage?: { url?: string | null } | null
}

interface Props {
  post: Post
}
const { post } = Astro.props

const date = post.publishedAt
  ? new Intl.DateTimeFormat('es-PY', { day: '2-digit', month: 'long', year: 'numeric' }).format(
      new Date(post.publishedAt),
    )
  : null
---

<a
  href={`/blog/${post.slug}/`}
  class="flex flex-col overflow-hidden rounded-3xl border border-[#e6e6e6] bg-white"
>
  <div class="aspect-[4/3] w-full bg-[#fafafa]">
    {
      post.featuredImage?.url && (
        <img
          src={mediaUrl(post.featuredImage)}
          alt={post.title}
          class="h-full w-full object-cover"
        />
      )
    }
  </div>
  <div class="flex flex-col gap-4 p-6">
    {date && <p class="font-sans text-sm text-[#808080]">{date}</p>}
    <p class="font-franklin-medium text-lg tracking-[-0.36px] text-black uppercase">
      {post.title}
    </p>
    <span class="flex items-center gap-2 font-franklin-medium text-sm text-[#ed8419]">
      Leer contenido
      <img src={ArrowDiagonal.src} alt="" class="size-4" />
    </span>
  </div>
</a>
