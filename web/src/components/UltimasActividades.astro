---
import ArrowDiagonal from '../assets/icons/arrow-diagonal.svg'
import BlogCard from './blog/BlogCard.astro'
import { fetchCollection } from '../lib/payload'

interface Post {
  id: number
  title: string
  slug: string
  publishedAt?: string | null
  featuredImage?: { url?: string | null } | null
}

const posts = await fetchCollection<Post>('posts', { sort: '-publishedAt', limit: '6' })
---

<section class="flex items-center justify-center bg-[#fafafa]">
  <div class="flex w-full max-w-[1216px] flex-col gap-16 py-24">
    <div class="flex flex-wrap items-center justify-between gap-6">
      <p class="font-sans text-5xl leading-[1.3] tracking-[-1px] text-black">Últimas Actividades</p>
      <a
        href="/blog/"
        class="font-franklin-medium flex shrink-0 items-center gap-2.5 rounded-[35px] border border-[#2e2e2e] px-8 py-4 text-base tracking-[-0.32px] text-[#2e2e2e]"
      >
        Visita nuestro blog
        <img src={ArrowDiagonal.src} alt="" class="size-6" />
      </a>
    </div>
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <BlogCard post={post} />)}
    </div>
  </div>
</section>
