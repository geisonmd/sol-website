---
const modules = import.meta.glob<{ default: { src: string } }>(
  '../../assets/sol-play/canales/*.jpg',
  { eager: true },
)
const canales = Object.values(modules).map((m) => m.default.src)
---

<section class="flex items-center justify-center overflow-hidden bg-[#181818] py-16">
  <div class="flex w-full max-w-[1216px] flex-col gap-10">
    <div class="flex flex-col items-center gap-2 text-center">
      <p class="font-franklin-medium text-sm tracking-[0.1em] text-[#ed8419] uppercase">
        Grilla de canales
      </p>
      <p class="font-sans text-4xl leading-[1.3] tracking-[-0.8px] text-white">
        ¡Una programación hecha para vos!
      </p>
    </div>
    <div class="grid grid-cols-3 gap-4 sm:grid-cols-4 lg:grid-cols-6">
      {
        canales.map((src) => (
          <div class="flex aspect-video items-center justify-center overflow-hidden rounded-xl bg-white/5 p-2">
            <img src={src} alt="" class="h-full w-full rounded-lg object-cover" />
          </div>
        ))
      }
    </div>
  </div>
</section>
