---
import IconTv from 'lucide-static/icons/tv.svg?raw'
import IconZap from 'lucide-static/icons/zap.svg?raw'
import IconFilm from 'lucide-static/icons/film.svg?raw'
import IconHeadset from 'lucide-static/icons/headset.svg?raw'

const items = [
  {
    icon: IconTv,
    title: '+ De 100 canales',
    text: 'Entretenimiento sin límites con más de 100 canales nacionales e internacionales a tu alcance.',
  },
  {
    icon: IconZap,
    title: 'Sin cortes',
    text: 'Conectate al contenido que te gusta, sin cortes y sin límites.',
  },
  {
    icon: IconFilm,
    title: 'Graba tus programas',
    text: 'Puedes grabar todos tus canales para ver cuando quieras.',
  },
  {
    icon: IconHeadset,
    title: 'Soporte dedicado',
    text: 'Soporte telefónico los 365 días del año.',
  },
]
---

<section class="flex items-center justify-center bg-[#fafafa]">
  <div class="flex w-full max-w-[1216px] flex-col gap-16 py-24">
    <p class="max-w-[600px] font-sans text-5xl leading-[1.3] tracking-[-1.28px] text-black">
      Disfrutá de todos los beneficios que Sol Play tiene para vos
    </p>
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        items.map((item) => (
          <div class="flex flex-col gap-4 rounded-3xl bg-white p-8">
            <span class="flex size-12 items-center justify-center rounded-full bg-[#ed8419]/10 text-[#ed8419] [&>svg]:size-6">
              <Fragment set:html={item.icon} />
            </span>
            <p class="font-franklin-medium text-base tracking-[-0.32px] text-black">
              {item.title}
            </p>
            <p class="font-sans text-base tracking-[-0.32px] text-[#808080]">{item.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
