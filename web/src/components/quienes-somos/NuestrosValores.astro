---
const cards = [
  {
    title: 'Nuestros valores',
    text: 'Empatía y Gratitud, Responsabilidad y Honestidad, Dedicación y Pertenencia, Perseverancia y Eficacia, Pericia y Profesionalismo.',
  },
  {
    title: 'Nuestra Misión',
    text: 'Comprender y satisfacer las necesidades de nuestros clientes y colaboradores.',
  },
  {
    title: 'Nuestra Visión',
    text: 'Ser reconocida como la mejor empresa de internet por su excelencia en el servicio, atención y calidez humana.',
  },
  {
    title: 'Nuestro Propósito',
    text: 'Generar conexiones de valores, posibilitando oportunidades para una mejor humanidad.',
  },
]
---

<section class="flex items-center justify-center bg-white">
  <div class="flex w-full max-w-[1216px] flex-col gap-16 py-24">
    <p class="max-w-[600px] font-sans text-5xl leading-[1.3] tracking-[-1.28px] text-black">
      Nuestros valores como empresa
    </p>
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        cards.map((c) => (
          <div class="flex flex-col gap-4 rounded-3xl bg-[#fafafa] p-8">
            <p class="font-franklin-medium text-lg tracking-[-0.36px] text-[#ed8419] uppercase">
              {c.title}
            </p>
            <p class="font-sans text-base tracking-[-0.32px] text-black">{c.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
