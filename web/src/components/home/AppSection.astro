---
import mockupDerecho from '../../assets/app/mockup-derecho.png'
import mockupIzquierdo from '../../assets/app/mockup-izquierdo.png'
import mockupBg from '../../assets/app/mockup-bg.jpg'
import solplayBadge from '../../assets/app/solplay-badge.png'
import IconDownloadCloud from 'lucide-static/icons/download-cloud.svg?raw'
import IconFileText from 'lucide-static/icons/file-text.svg?raw'
import IconActivity from 'lucide-static/icons/activity.svg?raw'
import IconWrench from 'lucide-static/icons/wrench.svg?raw'
import IconFlame from 'lucide-static/icons/flame.svg?raw'

const features = [
  { icon: IconDownloadCloud, text: 'Descarga gratuita en la tienda Google Play' },
  { icon: IconFileText, text: 'Realizar pagos y ver facturas pendientes' },
  { icon: IconActivity, text: 'Prueba tu ancho de banda' },
  { icon: IconWrench, text: 'Solicita asistencia de forma fácil y rápida' },
  { icon: IconFlame, text: 'Turbina tu conexión' },
]
---

<section class="flex items-center justify-center border-b border-[#d3d3d3] bg-[#fafafa]">
  <div class="flex w-full max-w-[1216px] items-center justify-between py-[164px]">
    <div class="relative flex w-[400px] shrink-0 items-center justify-center">
      <div
        class="absolute left-1/2 top-1/2 size-[420px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-cover opacity-80"
        style={`background-image: url(${mockupBg.src})`}
      >
      </div>
      <img
        src={solplayBadge.src}
        alt="Sol Internet"
        class="absolute left-0 top-6 h-[74px] w-[261px] drop-shadow-lg"
      />
      <img
        src={mockupIzquierdo.src}
        alt=""
        class="relative z-[1] w-[256px] -translate-x-10 translate-y-8 drop-shadow-xl"
      />
      <img
        src={mockupDerecho.src}
        alt="Pantalla de facturación de la App Sol Web"
        class="absolute right-0 top-20 z-[2] w-[277px] drop-shadow-xl"
      />
      <p class="absolute -bottom-10 left-0 w-[240px] font-sans text-base tracking-[-0.32px] text-[#1eae54]">
        Descarga en Google Play nuestra app oficial y gestiona tus facturas desde la plataforma
        Sol Web
      </p>
    </div>
    <div class="flex w-[520px] shrink-0 flex-col items-start gap-16">
      <p class="font-sans text-5xl leading-[1.3] tracking-[-1px] text-black">
        Tenga control total de tu internet desde la palma de tu mano
      </p>
      <div class="flex w-full flex-col items-start gap-6">
        {
          features.map((f, i) => (
            <>
              <div class="flex w-full items-center gap-4 px-8">
                <span
                  class="flex size-10 shrink-0 items-center justify-center rounded-full bg-[rgba(237,132,25,0.2)] [&>svg]:size-5 [&>svg]:text-[#ed8419]"
                  set:html={f.icon}
                />
                <p class="font-sans text-base tracking-[-0.32px] text-black">{f.text}</p>
              </div>
              {i < features.length - 1 && <div class="h-px w-full bg-[#e6e6e6]" />}
            </>
          ))
        }
      </div>
    </div>
  </div>
</section>
