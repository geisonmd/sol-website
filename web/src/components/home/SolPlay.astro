---
import ArrowDiagonal from '../../assets/icons/arrow-diagonal.svg'
import SolPlayMark from '../../assets/brand/sol-play-mark.svg'
import bg from '../../assets/home/sol-play-bg.png'
import googlePlayBadge from '../../assets/badges/google-play.jpg'
import androidTvBadge from '../../assets/badges/android-tv.jpg'
---

<section
  class="flex items-center justify-center bg-[#2e2e2e] bg-cover bg-top px-[100px]"
  style={`background-image: linear-gradient(90deg, rgba(46,46,46,0.85), rgba(46,46,46,0.4)), url(${bg.src})`}
>
  <div class="flex w-full max-w-[1216px] items-center justify-between py-[256px]">
    <div class="relative flex max-w-[592px] flex-col items-start gap-8">
      <p class="font-sans text-[64px] leading-[1.3] tracking-[-1.28px] text-white">
        Aprovecha tus canales favoritos sin cortes con Sol Play
      </p>
      <span class="flex size-16 items-center justify-center rounded-full bg-[#ed8419]">
        <img src={SolPlayMark.src} alt="" class="h-[33px] w-16" />
      </span>
      <p class="font-sans text-base tracking-[-0.32px] text-white">
        Olvídate de los cortes molestos y explora la televisión a través de internet con nuestra
        APP exclusiva, diseñada para garantizar una experiencia fluida y sin interrupciones.
        ¡Haz del entretenimiento una experiencia sin igual!
      </p>
      <div class="flex items-center gap-4">
        <a
          href="/planes"
          class="font-franklin-medium flex items-center gap-2 rounded-[35px] bg-[#25d366] px-8 py-4 text-base tracking-[-0.32px] text-white"
        >
          Contratar ahora
          <img src={ArrowDiagonal.src} alt="" class="size-6 invert" />
        </a>
        <a
          href="/sol-play"
          class="font-franklin-medium flex items-center justify-center rounded-[35px] border-[1.5px] border-white px-8 py-4 text-base tracking-[-0.32px] text-white"
        >
          Conocer más
        </a>
      </div>
    </div>
    <div class="flex items-center gap-6">
      <img src={googlePlayBadge.src} alt="Descarga en Google Play" class="h-12 rounded-md" />
      <img src={androidTvBadge.src} alt="Disponible en Android TV" class="h-12 rounded-md" />
    </div>
  </div>
</section>
