---
import ArrowDiagonal from '../../assets/icons/arrow-diagonal.svg'
import mujerFeliz from '../../assets/home/cta-mujer-feliz.png'
---

<section class="relative flex items-center justify-center overflow-hidden bg-[#ffb200] py-[164px]">
  <div
    class="pointer-events-none absolute -left-40 top-0 size-[550px] rounded-full bg-white/10 blur-[120px]"
  >
  </div>
  <div
    class="relative flex w-full max-w-[1216px] items-center justify-between overflow-hidden rounded-3xl bg-[#fafafa] p-16"
  >
    <div class="flex flex-col items-start gap-8">
      <p class="max-w-[705px] font-sans text-5xl leading-[1.3] tracking-[-1px] text-[#181818]">
        Que esperas para tener la conexión wi-fi ideal para ti?
      </p>
      <a
        href="/planes"
        class="font-franklin-medium flex items-center gap-2 rounded-[35px] bg-[#25d366] px-8 py-4 text-base tracking-[-0.32px] text-[#181818]"
      >
        Contratar ahora
        <img src={ArrowDiagonal.src} alt="" class="size-6" />
      </a>
    </div>
    <img
      src={mujerFeliz.src}
      alt=""
      class="pointer-events-none absolute -right-10 bottom-0 h-full max-h-[467px] object-contain"
    />
  </div>
</section>
