---
import IconGlobe from '../../assets/icons/globe.svg'
import { fetchCollection, mediaUrl } from '../../lib/payload'

interface Depoimento {
  id: number
  clientName: string
  city?: { name: string } | null
  yearsAsClient?: number | null
  comment: string
  photo?: { url?: string | null } | null
}

interface Props {
  title?: string
}
const { title = 'Palabras que nos mantienen impulsionados' } = Astro.props

const depoimentos = await fetchCollection<Depoimento>('depoimentos')
---

<section class="flex items-center justify-center border-b border-[#d3d3d3] bg-white">
  <div class="relative flex w-full max-w-[1216px] flex-col items-center gap-16 py-[164px]">
    <span
      class="pointer-events-none absolute -left-[75px] top-[52px] font-serif text-[160px] leading-none text-[#ed8419]/10"
      aria-hidden="true">"</span
    >
    <p class="relative text-center font-sans text-[64px] leading-[1.3] tracking-[-1.28px] text-black">
      {title}
    </p>
    <span
      class="flex size-16 items-center justify-center rounded-full bg-[#ffb200]"
      style="margin-top: -32px"
    >
      <img src={IconGlobe.src} alt="" class="h-[34px] w-[63px]" />
    </span>

    <div class="testemunial-swiper w-full overflow-hidden">
      <div class="swiper-wrapper items-stretch">
        {
          depoimentos.map((d) => (
            <div class="swiper-slide flex h-auto flex-col justify-between gap-6">
              <p class="font-franklin-book text-lg italic tracking-[-0.36px] text-black">
                "{d.comment}
              </p>
              <div class="flex items-center gap-4">
                {d.photo?.url ? (
                  <img src={mediaUrl(d.photo)} alt="" class="size-12 rounded-full object-cover" />
                ) : (
                  <span class="flex size-12 items-center justify-center rounded-full bg-[#ed8419]/20 font-franklin-medium text-black">
                    {d.clientName.charAt(0)}
                  </span>
                )}
                <div class="flex flex-col items-start">
                  <p class="font-franklin-medium text-base tracking-[-0.32px] text-black uppercase">
                    {d.clientName}
                  </p>
                  <div class="flex items-center gap-4 font-sans text-base tracking-[-0.32px] text-black">
                    {d.city?.name && <span>{d.city.name}</span>}
                    {d.yearsAsClient && (
                      <span>
                        <span class="font-franklin-medium text-lg tracking-[-0.36px]">
                          +{d.yearsAsClient}
                        </span>{' '}
                        años con Sol Internet
                      </span>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
    <div class="flex items-start justify-center gap-4">
      <div class="testemunial-prev flex items-center rounded-[35px] border-[1.5px] border-[#ed8419] bg-white px-12 py-3">
        <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
      <div class="testemunial-next flex items-center rounded-[35px] border-[1.5px] border-[#ed8419] bg-white px-12 py-3">
        <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
    </div>
    <span
      class="pointer-events-none absolute -right-[60px] bottom-[20px] font-serif text-[160px] leading-none text-[#ed8419]/10"
      aria-hidden="true">"</span
    >
  </div>
</section>

<script>
  import Swiper from 'swiper'
  import { Navigation } from 'swiper/modules'
  import 'swiper/css'

  new Swiper('.testemunial-swiper', {
    modules: [Navigation],
    slidesPerView: 1,
    spaceBetween: 64,
    breakpoints: {
      768: { slidesPerView: 3 },
    },
    navigation: {
      prevEl: '.testemunial-prev',
      nextEl: '.testemunial-next',
    },
  })
</script>
