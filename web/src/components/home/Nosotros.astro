---
import photo from '../../assets/home/nosotros-photo.jpg'
import IconX from 'lucide-static/icons/x.svg?raw'
---

<section class="relative h-[452px] overflow-hidden border-b border-[#d3d3d3] bg-[#d9d9d9]">
  <img src={photo.src} alt="" class="size-full object-cover" />
  <div class="absolute inset-0 bg-[#ef7800]/20 mix-blend-soft-light"></div>
  <span
    class="pointer-events-none absolute top-10 left-[8%] size-8 rotate-12 text-white/70 [&>svg]:size-8 [&>svg]:stroke-[3]"
    set:html={IconX}
  />
  <span
    class="pointer-events-none absolute right-[14%] bottom-14 size-10 -rotate-[20deg] text-white/60 [&>svg]:size-10 [&>svg]:stroke-[3]"
    set:html={IconX}
  />
  <span
    class="pointer-events-none absolute top-1/2 left-[42%] size-5 rotate-45 text-white/50 [&>svg]:size-5 [&>svg]:stroke-[3]"
    set:html={IconX}
  />
</section>
