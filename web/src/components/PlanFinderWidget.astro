---
import IconBot from 'lucide-static/icons/bot.svg?raw'
import IconX from 'lucide-static/icons/x.svg?raw'
import IconSend from 'lucide-static/icons/send.svg?raw'
import ArrowDiagonal from '../assets/icons/arrow-diagonal.svg'

const PAYLOAD_URL = import.meta.env.PAYLOAD_URL || 'https://cms.sol.com.py'
const WHATSAPP_NUMBER = '595983550110'
---

<div id="plan-finder" class="fixed right-4 bottom-4 z-50 flex flex-col items-end gap-3 sm:right-6 sm:bottom-6">
  <div
    id="plan-finder-panel"
    class="hidden h-[70vh] max-h-[640px] w-[92vw] max-w-[380px] flex-col overflow-hidden rounded-3xl border border-[#e6e6e6] bg-white shadow-2xl"
  >
    <div class="flex items-center justify-between bg-[#181818] px-5 py-4">
      <div class="flex items-center gap-3">
        <span class="flex size-9 items-center justify-center rounded-full bg-[#ed8419] text-white [&>svg]:size-5">
          <Fragment set:html={IconBot} />
        </span>
        <div class="flex flex-col">
          <p class="font-franklin-medium text-sm tracking-[-0.28px] text-white">
            Encontrá tu plan ideal
          </p>
          <p class="font-sans text-xs text-white/60">Asistente de Sol Internet</p>
        </div>
      </div>
      <button
        id="plan-finder-close"
        aria-label="Cerrar"
        class="flex size-8 items-center justify-center rounded-full text-white/70 hover:text-white [&>svg]:size-5"
      >
        <Fragment set:html={IconX} />
      </button>
    </div>

    <div id="plan-finder-messages" class="flex flex-1 flex-col gap-3 overflow-y-auto p-4"></div>

    <form id="plan-finder-form" class="flex items-center gap-2 border-t border-[#e6e6e6] p-3">
      <input
        id="plan-finder-input"
        type="text"
        autocomplete="off"
        placeholder="Escribí tu mensaje..."
        class="flex-1 rounded-full border border-[#e6e6e6] px-4 py-2.5 font-sans text-sm text-black outline-none placeholder:text-[#808080]"
      />
      <button
        type="submit"
        aria-label="Enviar"
        class="flex size-10 shrink-0 items-center justify-center rounded-full bg-[#ed8419] text-white [&>svg]:size-5"
      >
        <Fragment set:html={IconSend} />
      </button>
    </form>
  </div>

  <button
    id="plan-finder-toggle"
    class="flex items-center gap-2 rounded-full bg-[#ed8419] px-5 py-4 text-white shadow-lg [&>svg]:size-5"
  >
    <Fragment set:html={IconBot} />
    <span class="font-franklin-medium text-sm tracking-[-0.28px]">Encontrá tu plan</span>
  </button>
</div>

<template id="plan-finder-bubble-user">
  <div class="flex justify-end">
    <p class="max-w-[85%] rounded-2xl rounded-br-sm bg-[#ed8419] px-4 py-2.5 font-sans text-sm text-white"></p>
  </div>
</template>

<template id="plan-finder-bubble-assistant">
  <div class="flex flex-col items-start gap-2">
    <p class="max-w-[85%] rounded-2xl rounded-bl-sm bg-[#fafafa] px-4 py-2.5 font-sans text-sm whitespace-pre-line text-black"></p>
  </div>
</template>

<template id="plan-finder-cta">
  <a
    class="font-franklin-medium flex w-fit items-center gap-2 rounded-[35px] bg-[#25d366] px-5 py-2.5 text-sm text-white"
  >
    <span></span>
    <img src={ArrowDiagonal.src} alt="" class="size-4 invert" />
  </a>
</template>

<script define:vars={{ PAYLOAD_URL, WHATSAPP_NUMBER }}>
  const root = document.getElementById('plan-finder')
  const panel = document.getElementById('plan-finder-panel')
  const toggle = document.getElementById('plan-finder-toggle')
  const closeBtn = document.getElementById('plan-finder-close')
  const messagesEl = document.getElementById('plan-finder-messages')
  const form = document.getElementById('plan-finder-form')
  const input = document.getElementById('plan-finder-input')

  /** @type {{role: 'user' | 'assistant', content: string}[]} */
  let history = []
  let loading = false
  let opened = false

  function scrollToBottom() {
    messagesEl.scrollTop = messagesEl.scrollHeight
  }

  function addUserBubble(text) {
    const tpl = document.getElementById('plan-finder-bubble-user')
    const node = tpl.content.cloneNode(true)
    node.querySelector('p').textContent = text
    messagesEl.appendChild(node)
    scrollToBottom()
  }

  function addAssistantBubble(text, planTitle) {
    const tpl = document.getElementById('plan-finder-bubble-assistant')
    const node = tpl.content.cloneNode(true)
    node.querySelector('p').textContent = text
    const wrapper = node.firstElementChild
    if (planTitle) {
      const ctaTpl = document.getElementById('plan-finder-cta')
      const cta = ctaTpl.content.cloneNode(true)
      const link = cta.querySelector('a')
      const message = `Hola, me interesa el ${planTitle}`
      link.href = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`
      link.querySelector('span').textContent = `Contratar ${planTitle}`
      wrapper.appendChild(cta)
    }
    messagesEl.appendChild(node)
    scrollToBottom()
  }

  function addLoadingBubble() {
    const el = document.createElement('div')
    el.id = 'plan-finder-loading'
    el.className = 'flex items-center gap-1 px-4 py-2.5'
    el.innerHTML =
      '<span class="size-1.5 animate-bounce rounded-full bg-[#808080]"></span>' +
      '<span class="size-1.5 animate-bounce rounded-full bg-[#808080]" style="animation-delay:0.15s"></span>' +
      '<span class="size-1.5 animate-bounce rounded-full bg-[#808080]" style="animation-delay:0.3s"></span>'
    messagesEl.appendChild(el)
    scrollToBottom()
  }

  function removeLoadingBubble() {
    document.getElementById('plan-finder-loading')?.remove()
  }

  function open() {
    panel.classList.remove('hidden')
    panel.classList.add('flex')
    toggle.classList.add('hidden')
    if (!opened) {
      opened = true
      addAssistantBubble(
        'Hola! Te ayudo a encontrar el plan de internet ideal para vos. ¿Para qué vas a usar principalmente el internet: navegar y redes sociales, trabajar/videollamadas, streaming, gaming, o cámaras de seguridad?',
      )
    }
    input.focus()
  }

  function close() {
    panel.classList.add('hidden')
    panel.classList.remove('flex')
    toggle.classList.remove('hidden')
  }

  toggle.addEventListener('click', open)
  closeBtn.addEventListener('click', close)

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    const text = input.value.trim()
    if (!text || loading) return

    input.value = ''
    addUserBubble(text)
    history.push({ role: 'user', content: text })
    loading = true
    addLoadingBubble()

    try {
      const res = await fetch(`${PAYLOAD_URL}/api/plan-finder`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: history }),
      })
      const data = await res.json()
      removeLoadingBubble()

      if (!res.ok) {
        addAssistantBubble(
          data.error || 'Algo salió mal. Probá de nuevo o hablá con un representante por WhatsApp.',
        )
        return
      }

      const raw = data.reply || ''
      const match = raw.match(/\[CTA:(.+?)\]\s*$/)
      const planTitle = match ? match[1].trim() : null
      const cleanText = match ? raw.slice(0, match.index).trim() : raw.trim()

      history.push({ role: 'assistant', content: raw })
      addAssistantBubble(cleanText, planTitle)
    } catch {
      removeLoadingBubble()
      addAssistantBubble(
        'No pude conectarme. Probá de nuevo en un momento o hablá con un representante por WhatsApp.',
      )
    } finally {
      loading = false
    }
  })
</script>
