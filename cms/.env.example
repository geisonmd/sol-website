# Postgres connection string. On cPanel, create the DB + user under
# "PostgreSQL Databases" and use: postgresql://USER:PASSWORD@localhost:5432/DBNAME
DATABASE_URL=postgresql://postgres:payload@localhost:5432/sol_cms

# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=REPLACE_ME_WITH_A_RANDOM_SECRET

# URL of the Astro frontend that is allowed to call the Payload API (CORS/CSRF)
FRONTEND_URL=https://sol.com.py

# Port the Node app listens on (cPanel's Node.js Selector sets this for you)
PORT=3000

# Rebuild-on-publish webhook: when set, saving/deleting content in a
# collection with rebuildHooks() (or the Site Settings global) fires a
# GitHub repository_dispatch event, which the Astro repo's CI workflow
# (.github/workflows/rebuild.yml) picks up to rebuild (and later deploy)
# the static site. Leave unset to disable — hooks no-op silently.
GITHUB_DISPATCH_REPO=geisonmd/sol-website
# A GitHub token (classic PAT with "repo" scope, or a fine-grained token
# with "Contents: write" + "Actions: write" on this repo) used only to
# fire the dispatch event.
GITHUB_DISPATCH_TOKEN=
GITHUB_DISPATCH_EVENT_TYPE=payload-content-changed
