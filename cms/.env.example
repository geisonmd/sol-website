# Postgres connection string. On cPanel, create the DB + user under
# "PostgreSQL Databases" and use: postgresql://USER:PASSWORD@localhost:5432/DBNAME
DATABASE_URL=postgresql://postgres:payload@localhost:5432/sol_cms

# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=REPLACE_ME_WITH_A_RANDOM_SECRET

# URL of the Astro frontend that is allowed to call the Payload API (CORS/CSRF)
FRONTEND_URL=https://sol.com.py

# Port the Node app listens on (cPanel's Node.js Selector sets this for you)
PORT=3000
